# 配置分两级：
#   【平台注入】敏感项，请在平台「应用管理 → 环境变量」里配置，不要跟着 .env 打进镜像
#   【.env】    非敏感项，留在本文件当作配置文件即可
# 平台注入的环境变量优先级高于 .env（dotenv 不覆盖已存在的变量）。
# 生产环境启动时会自检：JWT_SECRET 若不是平台注入的，直接拒绝启动。

# 运行环境 development | production
NODE_ENV=development
# 服务监听端口（entrypoint.sh 与部署平台按需覆盖）
PORT=3000
HOST=0.0.0.0

# —— 平台注入（敏感）——
# MongoDB 连接串，泄露等于数据库可被读写
# 示例格式（不要填真实密码进示例文件）：
#   mongodb+srv://<用户名>:<密码>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#   mongodb://<用户名>:<密码>@<主机>:27017
MONGODB_URI=
# JWT 密钥，泄露等于任何人都能伪造 token 登录任意账号，生产必须平台注入
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# isbn.work 开放接口 key（只放服务端，绝不下发给客户端）
ISBN_WORK_KEY=

# —— 留在 .env（非敏感）——
MONGODB_DB=shishu
# 连接串没带库名时，认证库默认是 admin，需要时显式指定
# MONGODB_AUTH_SOURCE=admin

JWT_EXPIRES_IN=7d
ISBN_WORK_ENDPOINT=https://data.isbn.work/openApi/getInfoByIsbn
ISBN_WORK_TIMEOUT=8000

# 豆瓣兜底（有反爬，默认开，需限频）
DOUBAN_ENABLED=true
DOUBAN_INTERVAL=800

# 当当兜底（作者/出版社/出版时间/定价 比豆瓣更全，页面是 GBK 编码）
DANGDANG_ENABLED=true
DANGDANG_TIMEOUT=8000
DANGDANG_INTERVAL=800

# 图书缓存
BOOK_CACHE_HIT_TTL_DAYS=30
BOOK_CACHE_MISS_TTL_HOURS=6

# 限流（防刷）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_BOOK_MAX=60

# CORS：留空默认放开；生产建议填 H5 域名，逗号分隔
CORS_ORIGINS=
